{
  "name": "@iotexproject/swap-kit",
  "version": "0.0.0",
  "description": "Shared IoTeX swap engine (store, contract layer, UI) consumed by hub and mimo. App injects a wallet adapter and a token data source; behavioural differences are toggled via features.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "@uniswap/permit2-sdk": "^1.3.0",
    "@uniswap/sdk-core": "^4.2.0",
    "@uniswap/v3-sdk": "^3.10.0",
    "bignumber.js": "^9.1.0",
    "mobx": "^6.9.0",
    "viem": "^2.48.0"
  }
}
