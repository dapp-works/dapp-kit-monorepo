{
  "name": "@dappworks/swap-kit",
  "version": "0.0.0",
  "description": "Shared IoTeX swap engine (store, contract layer, UI) consumed by hub and mimo. Built on the @dappworks/kit store framework (peer); app injects token data source, config, helpers and UI; behavioural differences are toggled via features.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dataloader": "^2.2.2",
    "dayjs": "^1.11.8",
    "lodash": "^4.17.21",
    "numeral": "^2.0.6",
    "p-debounce": "^4.0.0"
  },
  "devDependencies": {
    "@dappworks/kit": "0.5.46",
    "@types/lodash": "^4.14.195",
    "@types/numeral": "^2.0.5",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "react": "^18.2.0",
    "@types/react": "^18.2.0",
    "bignumber.js": "9.1.2"
  },
  "peerDependencies": {
    "@dappworks/kit": ">=0.5.46",
    "@uniswap/permit2-sdk": "^1.3.0",
    "@uniswap/sdk-core": "^4.2.0",
    "@uniswap/v3-sdk": "^3.10.0",
    "bignumber.js": "^9.1.0",
    "mobx": "^6.9.0",
    "viem": "^2.48.0",
    "react": ">=18.0.0"
  }
}
